CC ?= clang
# Apple Silicon only: arm64 code for macOS 11 Big Sur (the first Apple Silicon
# release) and later, tuned for the M1 baseline every Apple Silicon Mac has.
MACOS_MIN ?= 11.0
ARCH_FLAGS ?= -arch arm64 -mmacosx-version-min=$(MACOS_MIN)
CPU_FLAGS ?= -mcpu=apple-m1
HARDEN_FLAGS ?= -fstack-protector-strong -D_FORTIFY_SOURCE=2
CFLAGS ?= -O3 -std=c11 -Wall -Wextra -Wpedantic -Werror -Isrc -Ibuild $(ARCH_FLAGS) $(CPU_FLAGS) $(HARDEN_FLAGS)
LDFLAGS ?= -lcups $(ARCH_FLAGS) -Wl,-dead_strip
# Shipped binaries get an ad-hoc signature with the hardened runtime, the form
# notarization needs (a Developer ID signature replaces it for distribution).
SIGN = /usr/bin/codesign --force --sign - --options runtime --identifier com.berkbb.p1600dn.$(notdir $@) $@
SANITIZER_FLAGS ?= -O1 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer -Isrc -Ibuild $(ARCH_FLAGS)
THREAD_SANITIZER_FLAGS ?= -O1 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -fsanitize=thread -fno-omit-frame-pointer -Isrc -Ibuild $(ARCH_FLAGS)
ANALYZE_FLAGS ?= -std=c11 -Wall -Wextra -Wpedantic -Werror -Isrc -Ibuild $(ARCH_FLAGS)
COVERAGE_FLAGS ?= -O0 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -fprofile-instr-generate -fcoverage-mapping -Isrc -Ibuild $(ARCH_FLAGS)

SRC_DIR = src
BUILD_DIR = build
PPD_DIR = ppd
TEST_DIR = test

# ZjStream + JBIG encoder, and the page renderer that feeds it.
ENCODER_SRCS = $(SRC_DIR)/jbig.c $(SRC_DIR)/jbig_ar.c $(SRC_DIR)/zjs_encoder.c $(SRC_DIR)/zjs_guard.c
RENDER_SRCS = $(ENCODER_SRCS) $(SRC_DIR)/p1600_screen.c $(SRC_DIR)/p1600_raster.c
# PJL USTATUS backchannel reader and the printer's status/progress messages.
STATUS_SRCS = $(SRC_DIR)/p1600_status.c
# Pages are JBIG-encoded on the performance cores in parallel.
POOL_SRCS = $(SRC_DIR)/p1600_encoder_pool.c
SRCS = $(RENDER_SRCS) $(STATUS_SRCS) $(POOL_SRCS) $(SRC_DIR)/rastertop1600dn.c
# Toner level command filter: LEDM over USB, snmpInk otherwise.
SUPPLY_SRCS = $(SRC_DIR)/p1600_supplies.c $(SRC_DIR)/p1600_usb.c $(SRC_DIR)/p1600_usb_ledm.c
COMMAND_SRCS = $(SUPPLY_SRCS) $(SRC_DIR)/p1600_status.c $(SRC_DIR)/p1600_utility.c $(SRC_DIR)/p1600_net.c $(SRC_DIR)/commandtop1600dn.c
USB_LIBS = -framework IOKit -framework CoreFoundation
# The diagnostic page is drawn with CoreGraphics and CoreText.
UTILITY_LIBS = $(USB_LIBS) -framework CoreGraphics -framework CoreText
# Printer transports of the utility: USB printer interface, AppSocket, Bonjour.
TRANSPORT_SRCS = $(SRC_DIR)/p1600_net.c $(SRC_DIR)/p1600_usb.c $(SRC_DIR)/p1600_supplies.c
# Printer utility core: PJL settings, pages, EWS proxy.
UTILITY_CORE_SRCS = $(SRC_DIR)/p1600_utility.c $(SRC_DIR)/p1600_ews_proxy.c $(SRC_DIR)/p1600_queues.c $(SRC_DIR)/p1600_diagnostic.c $(TRANSPORT_SRCS)
UTILITY_SRCS = $(UTILITY_CORE_SRCS) $(SRC_DIR)/p1600dn_utility.c

# The project's own halftone screens, generated by tools/gen_screens.py (make test-screens checks them).
SCREEN_TABLES = $(SRC_DIR)/p1600_screen_tables.h
PYTHON ?= python3

OBJS = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))
TARGET = $(BUILD_DIR)/rastertop1600dn
TEST_TARGET = $(BUILD_DIR)/test_driver
PROTOCOL_TEST_TARGET = $(BUILD_DIR)/test_protocol
FILTER_TEST_TARGET = $(BUILD_DIR)/test_filter
FILTER_MODES_TEST_TARGET = $(BUILD_DIR)/test_filter_modes
CUPS_PIPELINE_TEST_TARGET = $(BUILD_DIR)/test_cups_pipeline
STATUS_TARGET = $(BUILD_DIR)/p1600dn-status
COMMAND_TARGET = $(BUILD_DIR)/commandtop1600dn
UTILITY_TARGET = $(BUILD_DIR)/p1600dn-utility
# The app bundle name has spaces, so make tracks it through a stamp file.
UTILITY_APP = $(BUILD_DIR)/P1600dn Series Utility.app
UTILITY_APP_STAMP = $(BUILD_DIR)/utility-app.stamp
NOTIFIER_SRCS = $(SRC_DIR)/p1600_notify.c
NOTIFIER_APP = $(BUILD_DIR)/P1600dn Notifier.app
NOTIFIER_APP_STAMP = $(BUILD_DIR)/notifier-app.stamp
NOTIFY_TEST_TARGET = $(BUILD_DIR)/test_notify
AIRPRINT_CORE_SRCS = $(SRC_DIR)/p1600_airprint.c $(SRC_DIR)/p1600_raster_doc.c
AIRPRINT_SRCS = $(AIRPRINT_CORE_SRCS) $(SRC_DIR)/p1600_queues.c $(SRC_DIR)/p1600dn_airprint.c
AIRPRINT_LIBS = -lz -framework CoreFoundation -framework CoreGraphics -framework SystemConfiguration
AIRPRINT_TARGET = $(BUILD_DIR)/p1600dn-airprint
AIRPRINT_TEST_TARGET = $(BUILD_DIR)/test_airprint
STATUS_TEST_TARGET = $(BUILD_DIR)/test_status
USTATUS_TEST_TARGET = $(BUILD_DIR)/test_status_reader
POOL_TEST_TARGET = $(BUILD_DIR)/test_encoder_pool
GUARD_TEST_TARGET = $(BUILD_DIR)/test_guard
DIAGNOSTIC_TEST_TARGET = $(BUILD_DIR)/test_diagnostic
TRANSPORT_TEST_TARGET = $(BUILD_DIR)/test_transport
UTILITY_TEST_TARGET = $(BUILD_DIR)/test_utility
BENCH_TARGET = $(BUILD_DIR)/bench_filter
SUPPLIES_TEST_TARGET = $(BUILD_DIR)/test_supplies
# Command filter built against test/fake_snmpink.sh instead of Apple's snmpInk.
COMMAND_TEST_FILTER = $(BUILD_DIR)/commandtop1600dn-test
COMMAND_TEST_FLAGS = -DP1600_SNMPINK_PATH='"$(abspath $(TEST_DIR))/fake_snmpink.sh"' -DSNMPINK_TIMEOUT_SECONDS=2
COVERAGE_DIR = $(BUILD_DIR)/coverage
PPD_FILE = $(PPD_DIR)/P1600dn-Series.ppd
MANAGER = ./p1600dn_manager.command

PREFIX ?= /Library/Printers/p1600dn
PPD_INSTALL_DIR ?= /Library/Printers/PPDs/Contents/Resources

all: $(TARGET) $(STATUS_TARGET) $(COMMAND_TARGET) $(UTILITY_TARGET) $(UTILITY_APP_STAMP) $(NOTIFIER_APP_STAMP) $(AIRPRINT_TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c $(wildcard $(SRC_DIR)/*.h) $(SCREEN_TABLES) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): $(OBJS)
	$(CC) $(OBJS) $(LDFLAGS) -o $@
	$(SIGN)
	@echo "Built native driver binary: $(TARGET)"

$(COMMAND_TARGET): $(COMMAND_SRCS) $(SRC_DIR)/p1600_supplies.h $(SRC_DIR)/p1600_usb.h | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(COMMAND_SRCS) $(LDFLAGS) $(USB_LIBS) -o $@
	$(SIGN)
	@echo "Built toner level command filter: $(COMMAND_TARGET)"

$(UTILITY_TARGET): $(UTILITY_SRCS) $(wildcard $(SRC_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(UTILITY_SRCS) $(LDFLAGS) $(UTILITY_LIBS) -o $@
	$(SIGN)
	@echo "Built printer utility: $(UTILITY_TARGET)"

$(UTILITY_APP_STAMP): utility/P1600dnUtility.swift utility/Info.plist utility/Bridging.h $(UTILITY_CORE_SRCS) \
		$(wildcard $(SRC_DIR)/*.h) $(wildcard utility/Resources/*.lproj/*.strings) assets/P1600dnApp.icns \
		tools/build_utility_app.sh | $(BUILD_DIR)
	MACOS_MIN=$(MACOS_MIN) tools/build_utility_app.sh "$(UTILITY_APP)" $(BUILD_DIR)/utility
	@touch $@

# P1600dn Notifier: the printer's status and toner as macOS notifications.
$(NOTIFIER_APP_STAMP): notifier/P1600dnNotifier.swift notifier/Info.plist notifier/Bridging.h $(NOTIFIER_SRCS) \
		$(SRC_DIR)/p1600_queues.c $(wildcard $(SRC_DIR)/*.h) $(wildcard notifier/Resources/*.lproj/*.strings) \
		assets/P1600dnApp.icns tools/build_notifier_app.sh | $(BUILD_DIR)
	MACOS_MIN=$(MACOS_MIN) tools/build_notifier_app.sh "$(NOTIFIER_APP)" $(BUILD_DIR)/notifier
	@touch $@

notifier-app: $(NOTIFIER_APP_STAMP)

# AirPrint / IPP Everywhere server: jobs go to the CUPS queue (filter, page guard).
$(AIRPRINT_TARGET): $(AIRPRINT_SRCS) $(wildcard $(SRC_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(AIRPRINT_SRCS) $(LDFLAGS) $(AIRPRINT_LIBS) -o $@
	$(SIGN)
	@echo "Built AirPrint server: $@"

airprint: $(AIRPRINT_TARGET)

utility-app: $(UTILITY_APP_STAMP)

$(STATUS_TARGET): $(SRC_DIR)/p1600dn_status.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) $< $(LDFLAGS) -o $@
	$(SIGN)
	@echo "Built printer status utility: $(STATUS_TARGET)"

test-unit: $(SCREEN_TABLES) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_driver.c $(RENDER_SRCS) -lcups -o $(TEST_TARGET)
	@$(TEST_TARGET)

test-protocol: $(SCREEN_TABLES) | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_protocol.c $(ENCODER_SRCS) -o $(PROTOCOL_TEST_TARGET)
	@$(PROTOCOL_TEST_TARGET)

test-filter: $(TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_filter.c -lcups $(ARCH_FLAGS) -o $(FILTER_TEST_TARGET)
	@$(FILTER_TEST_TARGET) ./$(TARGET)

test-filter-modes: $(TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_filter_modes.c -lcups $(ARCH_FLAGS) -o $(FILTER_MODES_TEST_TARGET)
	@$(FILTER_MODES_TEST_TARGET) ./$(TARGET)

test-cups-pipeline: $(TARGET) $(SCREEN_TABLES)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_cups_pipeline.c $(RENDER_SRCS) -lcups $(ARCH_FLAGS) -o $(CUPS_PIPELINE_TEST_TARGET)
	@$(TEST_DIR)/test_cups_pipeline.sh ./$(TARGET) ./$(CUPS_PIPELINE_TEST_TARGET)

test-ustatus: $(TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_status_reader.c $(STATUS_SRCS) -lcups $(ARCH_FLAGS) -o $(USTATUS_TEST_TARGET)
	@$(USTATUS_TEST_TARGET) ./$(TARGET) $(PPD_FILE)

test-encoder-pool: $(TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_encoder_pool.c $(POOL_SRCS) $(ENCODER_SRCS) -lcups $(ARCH_FLAGS) -o $(POOL_TEST_TARGET)
	@$(POOL_TEST_TARGET) ./$(TARGET)

# The diagnostic page: PDFs for every paper, the CLI, and the real macOS
# chain with the page guard and the validator (src/p1600_diagnostic.c).
test-diagnostic: $(TARGET) $(UTILITY_TARGET) $(SCREEN_TABLES)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_diagnostic.c $(SRC_DIR)/p1600_diagnostic.c $(SRC_DIR)/p1600_queues.c -lcups $(UTILITY_LIBS) $(ARCH_FLAGS) -o $(DIAGNOSTIC_TEST_TARGET)
	@$(DIAGNOSTIC_TEST_TARGET) ./$(UTILITY_TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_cups_pipeline.c $(RENDER_SRCS) -lcups $(ARCH_FLAGS) -o $(CUPS_PIPELINE_TEST_TARGET)
	@$(TEST_DIR)/test_diagnostic.sh ./$(UTILITY_TARGET) ./$(TARGET) ./$(CUPS_PIPELINE_TEST_TARGET) ./$(DIAGNOSTIC_TEST_TARGET)

# AirPrint: unit tests, ipptool's IPP Everywhere suite, Apple raster/PWG/JPEG/PDF
# jobs through the real driver chain, Bonjour (local only).
test-airprint: $(TARGET) $(AIRPRINT_TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_airprint.c $(AIRPRINT_CORE_SRCS) -lcups $(AIRPRINT_LIBS) $(ARCH_FLAGS) -o $(AIRPRINT_TEST_TARGET)
	@$(AIRPRINT_TEST_TARGET) $(PPD_FILE)
	@P1600DN_AIRPRINT_TEST=./$(AIRPRINT_TEST_TARGET) $(TEST_DIR)/test_airprint.sh ./$(AIRPRINT_TARGET) ./$(TARGET) $(PPD_FILE)

# Notifier core against a stand-in cupsd, and the app bundle with a live run.
test-notify: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_notify.c $(NOTIFIER_SRCS) -lcups $(ARCH_FLAGS) -o $(NOTIFY_TEST_TARGET)
	@$(NOTIFY_TEST_TARGET)

test-notifier-app: $(NOTIFIER_APP_STAMP)
	@$(TEST_DIR)/test_notifier_app.sh "$(NOTIFIER_APP)"

# The page guard every page passes before it is sent (src/zjs_guard.c).
test-guard: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_guard.c $(POOL_SRCS) $(ENCODER_SRCS) $(ARCH_FLAGS) -o $(GUARD_TEST_TARGET)
	@$(GUARD_TEST_TARGET)

# Throughput on this Mac (A4 text/photo/black, FastRes and 600 dpi); timing only.
bench: $(TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/bench_filter.c -lcups $(ARCH_FLAGS) -o $(BENCH_TARGET)
	@$(BENCH_TARGET) ./$(TARGET) 8

test-transport: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_transport.c $(TRANSPORT_SRCS) -lcups $(USB_LIBS) $(ARCH_FLAGS) -o $(TRANSPORT_TEST_TARGET)
	@$(TRANSPORT_TEST_TARGET)

test-utility: $(UTILITY_TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_utility.c $(UTILITY_CORE_SRCS) -lcups $(UTILITY_LIBS) $(ARCH_FLAGS) -o $(UTILITY_TEST_TARGET)
	@$(UTILITY_TEST_TARGET) ./$(UTILITY_TARGET)

test-utility-app: $(UTILITY_APP_STAMP)
	@$(TEST_DIR)/test_utility_app.sh "$(UTILITY_APP)"

test-supplies: | $(BUILD_DIR)
	$(CC) $(CFLAGS) $(COMMAND_TEST_FLAGS) $(COMMAND_SRCS) $(LDFLAGS) $(USB_LIBS) -o $(COMMAND_TEST_FILTER)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_supplies.c $(SUPPLY_SRCS) -lcups $(USB_LIBS) $(ARCH_FLAGS) -o $(SUPPLIES_TEST_TARGET)
	@$(SUPPLIES_TEST_TARGET) ./$(COMMAND_TEST_FILTER)

# Regenerates the committed screen tables after a change to tools/gen_screens.py.
screens:
	$(PYTHON) -I tools/gen_screens.py $(SCREEN_TABLES)

# The committed screen tables are exactly what tools/gen_screens.py generates.
test-screens: | $(BUILD_DIR)
	$(PYTHON) -I tools/gen_screens.py $(BUILD_DIR)/gen_screens_check.h
	@cmp -s $(BUILD_DIR)/gen_screens_check.h $(SCREEN_TABLES) || { echo "    [FAIL] $(SCREEN_TABLES) differs from tools/gen_screens.py output (run make screens)"; exit 1; }
	@echo "    [PASS] Screen tables match tools/gen_screens.py"

test-ppd:
	@$(MANAGER) --test-ppds

test-status: $(STATUS_TARGET)
	$(CC) $(CFLAGS) $(TEST_DIR)/test_status.c -lcups $(ARCH_FLAGS) -o $(STATUS_TEST_TARGET)
	@$(STATUS_TEST_TARGET)
	@$(MANAGER) --test-status ./$(STATUS_TARGET)

test-manager: $(TARGET) $(STATUS_TARGET) $(COMMAND_TARGET) $(UTILITY_TARGET) $(UTILITY_APP_STAMP) $(NOTIFIER_APP_STAMP) $(AIRPRINT_TARGET)
	@$(MANAGER) --self-test
	@$(TEST_DIR)/test_manager_modes.sh

test: test-screens test-unit test-protocol test-guard test-filter test-filter-modes test-cups-pipeline test-encoder-pool test-ustatus test-supplies test-transport test-utility test-diagnostic test-utility-app test-notify test-notifier-app test-airprint test-ppd test-status test-manager

test-sanitize: $(SCREEN_TABLES) | $(BUILD_DIR)
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_driver.c $(RENDER_SRCS) -lcups -o $(BUILD_DIR)/test_driver_sanitize
	@$(BUILD_DIR)/test_driver_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_protocol.c $(ENCODER_SRCS) -o $(BUILD_DIR)/test_protocol_sanitize
	@$(BUILD_DIR)/test_protocol_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_guard.c $(POOL_SRCS) $(ENCODER_SRCS) -o $(BUILD_DIR)/test_guard_sanitize
	@$(BUILD_DIR)/test_guard_sanitize
	$(CC) $(SANITIZER_FLAGS) $(SRCS) -lcups -o $(BUILD_DIR)/rastertop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_filter.c -lcups -o $(BUILD_DIR)/test_filter_sanitize
	@$(BUILD_DIR)/test_filter_sanitize ./$(BUILD_DIR)/rastertop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_filter_modes.c -lcups -o $(BUILD_DIR)/test_filter_modes_sanitize
	@$(BUILD_DIR)/test_filter_modes_sanitize ./$(BUILD_DIR)/rastertop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_cups_pipeline.c $(RENDER_SRCS) -lcups -o $(BUILD_DIR)/test_cups_pipeline_sanitize
	@$(TEST_DIR)/test_cups_pipeline.sh ./$(BUILD_DIR)/rastertop1600dn_sanitize ./$(BUILD_DIR)/test_cups_pipeline_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_encoder_pool.c $(POOL_SRCS) $(ENCODER_SRCS) -lcups -o $(BUILD_DIR)/test_encoder_pool_sanitize
	@$(BUILD_DIR)/test_encoder_pool_sanitize ./$(BUILD_DIR)/rastertop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_status_reader.c $(STATUS_SRCS) -lcups -o $(BUILD_DIR)/test_status_reader_sanitize
	@$(BUILD_DIR)/test_status_reader_sanitize ./$(BUILD_DIR)/rastertop1600dn_sanitize $(PPD_FILE)
	$(CC) $(SANITIZER_FLAGS) $(COMMAND_TEST_FLAGS) $(COMMAND_SRCS) -lcups $(USB_LIBS) -o $(BUILD_DIR)/commandtop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_supplies.c $(SUPPLY_SRCS) -lcups $(USB_LIBS) -o $(BUILD_DIR)/test_supplies_sanitize
	@$(BUILD_DIR)/test_supplies_sanitize ./$(BUILD_DIR)/commandtop1600dn_sanitize
	$(CC) $(SANITIZER_FLAGS) $(UTILITY_SRCS) -lcups $(UTILITY_LIBS) -o $(BUILD_DIR)/p1600dn-utility_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_utility.c $(UTILITY_CORE_SRCS) -lcups $(UTILITY_LIBS) -o $(BUILD_DIR)/test_utility_sanitize
	@$(BUILD_DIR)/test_utility_sanitize ./$(BUILD_DIR)/p1600dn-utility_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_transport.c $(TRANSPORT_SRCS) -lcups $(USB_LIBS) -o $(BUILD_DIR)/test_transport_sanitize
	@$(BUILD_DIR)/test_transport_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_status.c -lcups -o $(BUILD_DIR)/test_status_sanitize
	@$(BUILD_DIR)/test_status_sanitize
	@echo "[*] ThreadSanitizer: encoder pool, writer thread and printer status reader"
	$(CC) $(THREAD_SANITIZER_FLAGS) $(SRCS) -lcups -o $(BUILD_DIR)/rastertop1600dn_tsan
	$(CC) $(THREAD_SANITIZER_FLAGS) $(TEST_DIR)/test_encoder_pool.c $(POOL_SRCS) $(ENCODER_SRCS) -lcups -o $(BUILD_DIR)/test_encoder_pool_tsan
	@TSAN_OPTIONS=halt_on_error=1 $(BUILD_DIR)/test_encoder_pool_tsan ./$(BUILD_DIR)/rastertop1600dn_tsan
	$(CC) $(THREAD_SANITIZER_FLAGS) $(TEST_DIR)/test_status_reader.c $(STATUS_SRCS) -lcups -o $(BUILD_DIR)/test_status_reader_tsan
	@TSAN_OPTIONS=halt_on_error=1 $(BUILD_DIR)/test_status_reader_tsan ./$(BUILD_DIR)/rastertop1600dn_tsan $(PPD_FILE)
	$(CC) $(THREAD_SANITIZER_FLAGS) $(TEST_DIR)/test_utility.c $(UTILITY_CORE_SRCS) -lcups $(UTILITY_LIBS) -o $(BUILD_DIR)/test_utility_tsan
	@TSAN_OPTIONS=halt_on_error=1 $(BUILD_DIR)/test_utility_tsan ./$(UTILITY_TARGET)
	$(CC) $(SANITIZER_FLAGS) $(AIRPRINT_SRCS) -lcups $(AIRPRINT_LIBS) -o $(BUILD_DIR)/p1600dn-airprint_sanitize
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_airprint.c $(AIRPRINT_CORE_SRCS) -lcups $(AIRPRINT_LIBS) -o $(BUILD_DIR)/test_airprint_sanitize
	@$(BUILD_DIR)/test_airprint_sanitize $(PPD_FILE)
	@P1600DN_AIRPRINT_TEST=./$(BUILD_DIR)/test_airprint_sanitize $(TEST_DIR)/test_airprint.sh ./$(BUILD_DIR)/p1600dn-airprint_sanitize ./$(TARGET) $(PPD_FILE)
	$(CC) $(THREAD_SANITIZER_FLAGS) $(AIRPRINT_SRCS) -lcups $(AIRPRINT_LIBS) -o $(BUILD_DIR)/p1600dn-airprint_tsan
	@TSAN_OPTIONS=halt_on_error=1 P1600DN_AIRPRINT_QUICK=1 P1600DN_AIRPRINT_TEST=./$(BUILD_DIR)/test_airprint_sanitize $(TEST_DIR)/test_airprint.sh ./$(BUILD_DIR)/p1600dn-airprint_tsan ./$(TARGET) $(PPD_FILE)
	$(CC) $(SANITIZER_FLAGS) $(TEST_DIR)/test_notify.c $(NOTIFIER_SRCS) -lcups -o $(BUILD_DIR)/test_notify_sanitize
	@$(BUILD_DIR)/test_notify_sanitize
	$(CC) $(THREAD_SANITIZER_FLAGS) $(TEST_DIR)/test_notify.c $(NOTIFIER_SRCS) -lcups -o $(BUILD_DIR)/test_notify_tsan
	@TSAN_OPTIONS=halt_on_error=1 $(BUILD_DIR)/test_notify_tsan

test-stress: test
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(PROTOCOL_TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(GUARD_TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(NOTIFY_TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(DIAGNOSTIC_TEST_TARGET) ./$(UTILITY_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(FILTER_TEST_TARGET) ./$(TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(FILTER_MODES_TEST_TARGET) ./$(TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(TEST_DIR)/test_cups_pipeline.sh ./$(TARGET) ./$(CUPS_PIPELINE_TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(UTILITY_TEST_TARGET) ./$(UTILITY_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(TRANSPORT_TEST_TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(POOL_TEST_TARGET) ./$(TARGET) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(USTATUS_TEST_TARGET) ./$(TARGET) $(PPD_FILE) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(SUPPLIES_TEST_TARGET) ./$(COMMAND_TEST_FILTER) >/dev/null
	@env MallocScribble=1 MallocPreScribble=1 MallocGuardEdges=1 MallocCheckHeapStart=1 MallocCheckHeapEach=100 $(STATUS_TEST_TARGET) >/dev/null
	@echo "[+] Guard Malloc stress suite passed."

analyze: $(SCREEN_TABLES) | $(BUILD_DIR)
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/jbig.c -o $(BUILD_DIR)/jbig.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/jbig_ar.c -o $(BUILD_DIR)/jbig_ar.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/zjs_encoder.c -o $(BUILD_DIR)/zjs_encoder.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/zjs_guard.c -o $(BUILD_DIR)/zjs_guard.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_screen.c -o $(BUILD_DIR)/p1600_screen.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_raster.c -o $(BUILD_DIR)/p1600_raster.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/rastertop1600dn.c -o $(BUILD_DIR)/rastertop1600dn.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_status.c -o $(BUILD_DIR)/p1600_status.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_encoder_pool.c -o $(BUILD_DIR)/p1600_encoder_pool.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_supplies.c -o $(BUILD_DIR)/p1600_supplies.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_usb.c -o $(BUILD_DIR)/p1600_usb.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_net.c -o $(BUILD_DIR)/p1600_net.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_queues.c -o $(BUILD_DIR)/p1600_queues.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_utility.c -o $(BUILD_DIR)/p1600_utility.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_ews_proxy.c -o $(BUILD_DIR)/p1600_ews_proxy.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600dn_utility.c -o $(BUILD_DIR)/p1600dn_utility.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_usb_ledm.c -o $(BUILD_DIR)/p1600_usb_ledm.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/commandtop1600dn.c -o $(BUILD_DIR)/commandtop1600dn.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600dn_status.c -o $(BUILD_DIR)/p1600dn_status.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_notify.c -o $(BUILD_DIR)/p1600_notify.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_airprint.c -o $(BUILD_DIR)/p1600_airprint.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_raster_doc.c -o $(BUILD_DIR)/p1600_raster_doc.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600dn_airprint.c -o $(BUILD_DIR)/p1600dn_airprint.plist
	$(CC) --analyze $(ANALYZE_FLAGS) $(SRC_DIR)/p1600_diagnostic.c -o $(BUILD_DIR)/p1600_diagnostic.plist

coverage: $(SCREEN_TABLES) | $(BUILD_DIR)
	mkdir -p $(COVERAGE_DIR)
	rm -f $(COVERAGE_DIR)/*.profraw $(COVERAGE_DIR)/merged.profdata
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_driver.c $(RENDER_SRCS) -lcups -o $(COVERAGE_DIR)/test_driver
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/unit-%p.profraw' $(COVERAGE_DIR)/test_driver >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_protocol.c $(ENCODER_SRCS) -o $(COVERAGE_DIR)/test_protocol
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/protocol-%p.profraw' $(COVERAGE_DIR)/test_protocol >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_guard.c $(POOL_SRCS) $(ENCODER_SRCS) -o $(COVERAGE_DIR)/test_guard
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/guard-%p.profraw' $(COVERAGE_DIR)/test_guard >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(SRCS) -lcups -o $(COVERAGE_DIR)/filter
	$(CC) $(CFLAGS) $(TEST_DIR)/test_filter.c -lcups $(ARCH_FLAGS) -o $(COVERAGE_DIR)/test_filter
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/filter-base-%p.profraw' $(COVERAGE_DIR)/test_filter $(COVERAGE_DIR)/filter >/dev/null
	$(CC) $(CFLAGS) $(TEST_DIR)/test_filter_modes.c -lcups $(ARCH_FLAGS) -o $(COVERAGE_DIR)/test_filter_modes
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/filter-modes-%p.profraw' $(COVERAGE_DIR)/test_filter_modes $(COVERAGE_DIR)/filter >/dev/null
	$(CC) $(CFLAGS) $(TEST_DIR)/test_cups_pipeline.c $(RENDER_SRCS) -lcups $(ARCH_FLAGS) -o $(COVERAGE_DIR)/test_cups_pipeline
	@P1600DN_PIPELINE_WORKDIR='$(abspath $(COVERAGE_DIR))' LLVM_PROFILE_FILE='cups-pipeline-%p.profraw' \
		$(abspath $(TEST_DIR))/test_cups_pipeline.sh $(abspath $(COVERAGE_DIR))/filter \
		$(abspath $(COVERAGE_DIR))/test_cups_pipeline >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_status.c -lcups -o $(COVERAGE_DIR)/test_status
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/status-%p.profraw' $(COVERAGE_DIR)/test_status >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_encoder_pool.c $(POOL_SRCS) $(ENCODER_SRCS) -lcups -o $(COVERAGE_DIR)/test_encoder_pool
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/pool-%p.profraw' $(COVERAGE_DIR)/test_encoder_pool $(COVERAGE_DIR)/filter >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(UTILITY_SRCS) -lcups $(UTILITY_LIBS) -o $(COVERAGE_DIR)/utility
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_utility.c $(UTILITY_CORE_SRCS) -lcups $(UTILITY_LIBS) -o $(COVERAGE_DIR)/test_utility
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/utility-%p.profraw' $(COVERAGE_DIR)/test_utility $(COVERAGE_DIR)/utility >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_transport.c $(TRANSPORT_SRCS) -lcups $(USB_LIBS) -o $(COVERAGE_DIR)/test_transport
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/transport-%p.profraw' $(COVERAGE_DIR)/test_transport >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_status_reader.c $(STATUS_SRCS) -lcups -o $(COVERAGE_DIR)/test_status_reader
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/ustatus-%p.profraw' $(COVERAGE_DIR)/test_status_reader $(COVERAGE_DIR)/filter $(PPD_FILE) >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(COMMAND_TEST_FLAGS) $(COMMAND_SRCS) -lcups $(USB_LIBS) -o $(COVERAGE_DIR)/command
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_supplies.c $(SUPPLY_SRCS) -lcups $(USB_LIBS) -o $(COVERAGE_DIR)/test_supplies
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/supplies-%p.profraw' $(COVERAGE_DIR)/test_supplies $(COVERAGE_DIR)/command >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_notify.c $(NOTIFIER_SRCS) -lcups -o $(COVERAGE_DIR)/test_notify
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/notify-%p.profraw' $(COVERAGE_DIR)/test_notify >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_diagnostic.c $(SRC_DIR)/p1600_diagnostic.c $(SRC_DIR)/p1600_queues.c -lcups $(UTILITY_LIBS) -o $(COVERAGE_DIR)/test_diagnostic
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/diagnostic-%p.profraw' $(COVERAGE_DIR)/test_diagnostic $(COVERAGE_DIR)/utility >/dev/null
	$(CC) $(COVERAGE_FLAGS) $(TEST_DIR)/test_airprint.c $(AIRPRINT_CORE_SRCS) -lcups $(AIRPRINT_LIBS) -o $(COVERAGE_DIR)/test_airprint
	@LLVM_PROFILE_FILE='$(COVERAGE_DIR)/airprint-%p.profraw' $(COVERAGE_DIR)/test_airprint $(PPD_FILE) >/dev/null
	@/usr/bin/xcrun llvm-profdata merge -sparse $(COVERAGE_DIR)/*.profraw -o $(COVERAGE_DIR)/merged.profdata
	@/usr/bin/xcrun llvm-cov report $(COVERAGE_DIR)/filter -object $(COVERAGE_DIR)/test_status \
		-object $(COVERAGE_DIR)/test_status_reader -object $(COVERAGE_DIR)/command -object $(COVERAGE_DIR)/test_supplies \
		-object $(COVERAGE_DIR)/test_encoder_pool -object $(COVERAGE_DIR)/utility -object $(COVERAGE_DIR)/test_utility \
		-object $(COVERAGE_DIR)/test_transport -object $(COVERAGE_DIR)/test_guard \
		-object $(COVERAGE_DIR)/test_notify -object $(COVERAGE_DIR)/test_diagnostic -object $(COVERAGE_DIR)/test_airprint \
		-instr-profile=$(COVERAGE_DIR)/merged.profdata -ignore-filename-regex='test/' \
		$(SRCS) $(SRC_DIR)/p1600dn_status.c $(SRC_DIR)/commandtop1600dn.c $(SUPPLY_SRCS) $(UTILITY_SRCS) \
		$(NOTIFIER_SRCS) $(AIRPRINT_CORE_SRCS)

test-all: test test-sanitize test-stress analyze coverage

status: $(STATUS_TARGET)
	@$(STATUS_TARGET)

PAPPL_TARGET = $(BUILD_DIR)/p1600dn-app

pappl: $(BUILD_DIR)
	@if pkg-config --exists pappl 2>/dev/null; then \
		$(CC) $(CFLAGS) $(ARCH_FLAGS) -DHAVE_PAPPL=1 $(SRC_DIR)/pappl_p1600dn.c $(ENCODER_SRCS) $$(pkg-config --cflags --libs pappl) -o $(PAPPL_TARGET) && \
		echo "[+] PAPPL Printer Application derlendi: $(PAPPL_TARGET)"; \
	else \
		$(CC) $(CFLAGS) $(ARCH_FLAGS) $(SRC_DIR)/pappl_p1600dn.c -o $(PAPPL_TARGET) && \
		echo "[*] PAPPL Printer Application derlendi (standalone): $(PAPPL_TARGET)"; \
	fi

clean:
	rm -rf $(BUILD_DIR) *.zm *.zjs *.plist

install:
	@$(MANAGER) --install

uninstall:
	@$(MANAGER) --uninstall

manager:
	@$(MANAGER)

